# TrajectoryRL Configuration
# Copy to .env.validator and fill in your values:  cp .env.validator.example .env.validator

# =============================================================================
# Operating mode
# =============================================================================
# Default (unset / 0): WEIGHT-ONLY. The validator reads the current winner from
# the subnet API and sets on-chain weights for it. It does not evaluate
# anything, so it needs no LLM key and no Docker socket.
#
# EVAL_ENABLED=1: the validator also evaluates each epoch's challenger in the
# trajrl-bench sandbox and submits the score. This needs LLM_API_KEY below, the
# Docker socket, and a box sized for the sandbox (see docs/VALIDATOR_OPERATIONS.md).
#
# After changing this, recreate the container so it re-reads this file:
#   docker compose -f docker/docker-compose.validator.yml --env-file .env.validator up -d validator
# (a plain `docker restart` or a watchtower image update keeps the old value).
# EVAL_ENABLED=0

# =============================================================================
# LLM API key — engy (https://engy.ai), the subnet's OpenAI-compatible API
# (only used when EVAL_ENABLED=1)
# =============================================================================
# The models and endpoints are FIXED IN THE VALIDATOR CODE and identical for
# every validator, because miners must be scored against the same model or
# scores aren't comparable:
#   - Testee (runs the miner's SKILL.md): Qwen3.8-27B on engy
#   - Judge  (scores the testee):         GLM-5.2 on engy
# A different family for the judge keeps its bias uncorrelated with the testee —
# that split is what lets scoring separate real packs from no-skill baselines.
#
# You therefore do NOT set the model or base URL here. Any LLM_MODEL /
# LLM_BASE_URL / JUDGE_MODEL / JUDGE_BASE_URL you set is IGNORED (the validator
# logs a warning). Changing the fleet's model is a code change + release, not an
# operator setting.
#
# You supply only your engy API key. Get one at https://engy.ai.
LLM_API_KEY=

# The judge shares the same engy endpoint, so JUDGE_API_KEY can stay empty to
# reuse LLM_API_KEY. Set it only for a separate engy billing/quota lane.
JUDGE_API_KEY=

# =============================================================================
# Bittensor
# =============================================================================
WALLET_NAME=validator
WALLET_HOTKEY=default
NETUID=11
NETWORK=finney          # finney, test, or local

# =============================================================================
# IPFS (Consensus Payload Storage)
# =============================================================================
# IPFS_API_URL: kubo HTTP API endpoint (including /api/v0 prefix).
#   Used for upload (POST /add) and primary download (POST /cat).
#
# IPFS_GATEWAYS: Comma-separated public gateways for download fallback.
#   Tried sequentially if kubo API download fails.
#
# Default: uses ipfs.metahash73.com shared node with ipfs.io + cloudflare fallback.
# Override IPFS_API_URL to use your own kubo node (e.g. http://localhost:5001/api/v0).
#
# IPFS_API_URL=http://ipfs.metahash73.com:5001/api/v0
# IPFS_GATEWAYS=https://ipfs.io,https://dweb.link

# =============================================================================
# Optional
# =============================================================================
# LOG_LEVEL=INFO              # DEBUG, INFO, WARNING, ERROR

# =============================================================================
# Advanced (defaults are fine for most setups)
# =============================================================================
# EVAL_STATE_PATH=/var/lib/trajectoryrl/eval_state.json  # Path for persisted eval state

# Image channel for sandbox/harness images (e.g. latest, staging, v1.2.0-rc.1).
# Normally set by the compose file you launch (latest -> prod, staging -> staging).
# Override here only for special debugging.
# IMAGE_CHANNEL=latest

# Per-episode sandbox timeout (seconds). Default 600s — Qwen3.8 testees occasionally
# need 4-5 min on hard codebase_fix episodes; 180s (the previous default) caused
# preventable timeouts. Lower only if you're using a faster testee.
# SANDBOX_TIMEOUT_PER_EPISODE=600
